# Copy to .env and adjust for your environment.

# PostgreSQL (primary target). For a quick local demo without Postgres you can
# point this at SQLite instead: sqlite:///./uep_emmy.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/uep_emmy

# Local S3 simulation
STORAGE_ROOT=./storage
STORAGE_BUCKET=uep-emmy-media

# Uploads
MAX_UPLOAD_MB=10

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:5173

# Auth: signs session tokens; set your own value for any shared deployment.
SECRET_KEY=dev-only-change-me
TOKEN_TTL_HOURS=168

# Refuse to start while any triage rule has an unverified citation.
#
# MUST be true in any environment real owners can reach. It is false here because
# no citation is verified yet, so a true value refuses to start the engine at all
# — which is the gate working, not a bug.
#
# A citation becomes verified when a named veterinarian confirms it supports the
# exact claim its rule makes, and their name is recorded in `Citation.verified_by`.
# Nobody has done that, so flipping this to true today will simply stop the
# application booting. The open clinical questions are held outside the repo —
# ask the team for the veterinary adjudication packet.
TRIAGE_REQUIRE_VERIFIED_RULES=false

# ---------------------------------------------------------------------------
# Email
#
# Leave SMTP_HOST empty and NOTHING is sent. Every message is written to
# <STORAGE_ROOT>/outbox as a complete .eml file and recorded as "unavailable" —
# never as "sent". That is the default deliberately: this runs in Docker with no
# mail credentials, and a sender that throws on every notification is worse than
# one that writes down what it would have sent.
#
# Inspect what would have gone out:
#   python -m app.scripts.outbox            # list the messages, newest first
#   python -m app.scripts.outbox --show 1   # print one, both bodies and links
#
# Once you HAVE set SMTP below, check it before testing the app through it:
#   python -m app.scripts.check_smtp                     # connect, secure, log in
#   python -m app.scripts.check_smtp --send you@you.com  # and send one real message
#
# Gmail needs an App Password (Google Account -> Security -> 2-Step Verification
# -> App passwords), not your account password, and SMTP_FROM must match the
# authenticated account:
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USE_TLS=true
#   SMTP_USERNAME=you@gmail.com / SMTP_FROM=UEP EMMY <you@gmail.com>
#
# Or run a local capture server and point SMTP_HOST at it — MailHog and
# Mailpit both listen on 1025 and show every message in a web inbox:
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost / SMTP_PORT=1025 / SMTP_USE_TLS=false
#
# docker-compose.yml automatically reads backend/.env when it exists. Keep the
# file private. When using the Docker frontend, set FRONTEND_BASE_URL to
# http://localhost:8080; the http://localhost:5173 default below is for Vite.
#
# NEVER commit real credentials. Every value below is a placeholder.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on port 587. Set false only for a local capture server on 1025.
SMTP_USE_TLS=true
# Implicit TLS from the first byte, for port 465. Wins over SMTP_USE_TLS when
# both are set — a server on 465 will not answer a plaintext EHLO.
SMTP_USE_SSL=false
SMTP_FROM=UEP EMMY <no-reply@uepemmy.local>
# Give up on a mail server that accepts the connection and then says nothing.
SMTP_TIMEOUT_SECONDS=10

# Where the browser is. Every link inside an email is built against this, and
# there is nothing to derive it from at send time — the queue runs in a
# background task with no request to read a Host header off.
# MUST be the public address of the frontend in any real deployment; a link to
# http://localhost:5173 in somebody's inbox goes nowhere.
FRONTEND_BASE_URL=http://localhost:5173

# The queue. Endpoints write messages down and return; this loop delivers them,
# so no request ever waits on SMTP.
EMAIL_SWEEP_SECONDS=30
EMAIL_BATCH_SIZE=20
# Attempts before a message is given up on as failed. The backoff is 1 min,
# 5 min, 30 min, 2 h — about two hours in total, long enough to ride out a mail
# server restart.
EMAIL_MAX_ATTEMPTS=5

# How long the one-time links last. Address verification is proof of an inbox
# and can afford to be generous; a password reset IS the password for as long
# as it lives, so it is short.
VERIFY_EMAIL_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
