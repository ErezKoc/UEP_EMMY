# Copy to .env and adjust for your environment.

# PostgreSQL (primary target). For a quick local demo without Postgres you can
# point this at SQLite instead: sqlite:///./uep_emmy.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/uep_emmy

# Local S3 simulation
STORAGE_ROOT=./storage
STORAGE_BUCKET=uep-emmy-media

# Uploads
MAX_UPLOAD_MB=10

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:5173
