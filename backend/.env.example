# Copy to .env and adjust for your environment.

# PostgreSQL (primary target). For a quick local demo without Postgres you can
# point this at SQLite instead: sqlite:///./uep_emmy.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/uep_emmy

# Local S3 simulation
STORAGE_ROOT=./storage
STORAGE_BUCKET=uep-emmy-media

# Uploads
MAX_UPLOAD_MB=10

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:5173

# Auth: signs session tokens; set your own value for any shared deployment.
SECRET_KEY=dev-only-change-me
TOKEN_TTL_HOURS=168

# Refuse to start while any triage rule has an unverified citation.
#
# MUST be true in any environment real owners can reach. It is false here because
# no citation is verified yet, so a true value refuses to start the engine at all
# — which is the gate working, not a bug.
#
# A citation becomes verified when a named veterinarian confirms it supports the
# exact claim its rule makes, and their name is recorded in `Citation.verified_by`.
# Nobody has done that, so flipping this to true today will simply stop the
# application booting. The open clinical questions are held outside the repo —
# ask the team for the veterinary adjudication packet.
TRIAGE_REQUIRE_VERIFIED_RULES=false
